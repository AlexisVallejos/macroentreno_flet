# --- Servidor ---
PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS (separados por coma). "*" acepta cualquiera (solo desarrollo).
CORS_ORIGIN=*

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=macroentreno

# --- JWT ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambiar_por_un_secreto_largo_de_acceso
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_largo_de_renovacion
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# --- Inicio de sesión social (OAuth del lado del servidor) ---
# URL pública con la que el navegador del celular llega a esta API. Google y Facebook
# exigen HTTPS: en desarrollo usá un túnel (ngrok, cloudflared). GitHub acepta http.
PUBLIC_API_URL=
# Esquemas de la app a los que se puede volver (macroentreno = APK, exp = Expo Go)
APP_REDIRECT_SCHEMES=macroentreno,exp,exps
# Callback a registrar en cada proveedor: <PUBLIC_API_URL>/api/auth/oauth/<proveedor>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- MacroEntreno Pro: micronutrientes con FatSecret ---
# Claves de https://platform.fatsecret.com (OAuth 1.0: no hace falta habilitar la IP del servidor).
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=
FATSECRET_REGION=AR
FATSECRET_LANGUAGE=es

# --- Bases de alimentos gratuitas ---
# Open Food Facts no usa clave, pero pide identificar la app (nombre/versión y contacto).
OFF_USER_AGENT=MacroEntreno/1.0 (tu-email@ejemplo.com)
# USDA FoodData Central: clave gratis en https://fdc.nal.usda.gov/api-key-signup (1000 consultas/hora).
# Sin clave se usa DEMO_KEY, que alcanza solo para probar.
USDA_API_KEY=

# --- Asistente con IA (OpenAI) ---
# 1) Creá una clave en https://platform.openai.com/api-keys (empieza con "sk-", ej. sk-proj-...).
# 2) Pegala en OPENAI_API_KEY de backend/.env (copia de este archivo, que git ignora), sin comillas.
# 3) Reiniciá la API (npm run dev). Al arrancar, el log dice "Asistente con IA: activo".
# Sin clave, el asistente responde 503 AI_NOT_CONFIGURED y la app muestra cómo configurarlo.
# La cuenta de OpenAI necesita saldo cargado (Settings → Billing); sin saldo la app avisa "se quedó sin saldo".
OPENAI_API_KEY=
# Modelo con visión y herramientas. gpt-6-luna es ~20 veces más barato, pero estima peor las fotos.
OPENAI_MODEL=gpt-6.1-sol
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# --- MacroEntreno Pro: cobro mensual con Mercado Pago ---
# Access token de https://www.mercadopago.com.ar/developers (empieza con TEST- en modo prueba).
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de Webhooks del panel (valida la firma de las notificaciones). Webhook a registrar:
# <PUBLIC_API_URL>/api/billing/webhook  · eventos: "Planes y suscripciones"
MERCADOPAGO_WEBHOOK_SECRET=
# Precio mensual y moneda
PRO_PRICE=4999
PRO_CURRENCY=ARS
# URL de la app web: Mercado Pago vuelve a <PUBLIC_APP_URL>/pro después de pagar
PUBLIC_APP_URL=
